# Antra bridge configuration. Copy to .env and adjust. Values below are the
# defaults the code would use anyway; the .env exists so they are visible.

BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8890
BRIDGE_STAGING_DIR=<antra-lidarr>/staging
ANTRAA_REPO_DIR=<antra-lidarr>/antra
BRIDGE_DB_PATH=./bridge.db
BRIDGE_FORMAT=flac
BRIDGE_SOURCES=auto
BRIDGE_FETCH_LYRICS=true
BRIDGE_CONCURRENCY=1
BRIDGE_PROBE_ENABLED=true
BRIDGE_PROBE_TRACKS=1
BRIDGE_CACHE_TTL_S=21600
BRIDGE_RATE_LIMIT_COOLDOWN_S=300
BRIDGE_API_TOKEN=
BRIDGE_LOG_LEVEL=INFO

# Engine safety for headless operation: never prompt for interactive Soulseek
# setup (see NOTES.md gotcha G1). Set SLSKD_BASE_URL + SLSKD_API_KEY instead
# when a slskd instance should be used.
SLSKD_AUTO_BOOTSTRAP=false
